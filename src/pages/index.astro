---
import Layout from '../layouts/Layout.astro';
import Soundboard from '../components/Soundboard.svelte';
---

<Layout>
  <header class="page-header">
    <h1>The Merchant</h1>
    <p class="subtitle">"Greetings, traveler..." — tap a mood, hear a random line</p>
  </header>

  <Soundboard client:load />

  <footer class="page-footer">
    <p>
      Fan-made, non-commercial. Voice clips are © Mega Crit Games, extracted from a
      legitimately-owned copy of <em>Slay the Spire 2</em> — not affiliated with or endorsed by
      Mega Crit Games.
    </p>
  </footer>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 1rem 0;
  }

  h1 {
    font-size: 1.4rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    text-shadow: 0 0 8px rgba(201, 164, 76, 0.3);
  }

  .subtitle {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--cream-dim);
  }

  .page-footer {
    max-width: 640px;
    margin: 1rem auto 2rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .page-footer p {
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--cream-dim);
  }
</style>
