---
import Layout from '../layouts/Layout.astro';
import Soundboard from '../components/Soundboard.svelte';
---

<Layout>
  <div class="app">
    <header class="page-header">
      <h1>The Merchant</h1>
      <p class="subtitle">"Greetings, traveler..." — tap a mood, hear a random line</p>
    </header>

    <Soundboard client:load />
  </div>

  <footer class="page-footer">
    <p>
      Fan-made, non-commercial. Voice clips are © Mega Crit Games, extracted from a
      legitimately-owned copy of <em>Slay the Spire 2</em> — not affiliated with or endorsed by
      Mega Crit Games.
    </p>
  </footer>
</Layout>

<style>
  /* min-height (not height) + the Soundboard island's own flex:1 below it
     is what guarantees the header + figure + all 8 buttons + status fit in
     one viewport without scrolling, on any screen size -- see
     Soundboard.svelte's .board/.grid for the matching flex/fr-grid math.
     The footer disclaimer intentionally lives outside .app, below the fold:
     it doesn't need to be tappable, so it's fine if reaching it takes a
     small scroll. */
  .app {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .page-header {
    flex-shrink: 0;
    text-align: center;
    padding: 0.6rem 1rem 0;
  }

  h1 {
    font-size: clamp(1rem, 3.2vh, 1.4rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    text-shadow: 0 0 8px rgba(201, 164, 76, 0.3);
  }

  .subtitle {
    margin-top: 0.25rem;
    font-size: clamp(0.65rem, 1.8vh, 0.8rem);
    font-style: italic;
    color: var(--cream-dim);
  }

  .page-footer {
    max-width: 640px;
    margin: 1rem auto 2rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .page-footer p {
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--cream-dim);
  }
</style>
